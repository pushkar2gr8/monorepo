{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "personal-loans",
  "projectType": "application",
  "sourceRoot": "apps/personal-loans",
  "tags": ["team:personal-loans", "scope:loans"],
  "implicitDependencies": ["loan-calculator", "loan-page", "form-workflow"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["loan-calculator"], "target": "build-v2" },
        { "projects": ["loan-page"], "target": "build-v2" }
      ],
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "npm run build --workspace=@nbfc/personal-loans",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
